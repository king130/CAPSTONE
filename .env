# Local dev: leave empty so requests use /api and the Vite dev proxy (see vite.config.ts -> server.proxy).
# Production: Vite bakes this in at *build* time — set before `npm run build`, then redeploy dist.
# Use the full Laravel API base. You may use https://api.example.com (we append /api) or https://api.example.com/api explicitly.
# Laravel backend .env must set FRONTEND_URL to this SPA's origin and CORS_ALLOWED_ORIGINS if needed.
VITE_API_BASE_URL=https://lightyellow-cassowary-162950.hostingersite.com/backend/public/api

#if local dev blank this URL

#if production set this URL to https://lightyellow-cassowary-162950.hostingersite.com/backend/public/api
                                #should be always npm run build and redeploy dist