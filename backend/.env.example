APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public URL of this app; the hostname is also used for SMTP EHLO unless you set MAIL_EHLO_DOMAIN in .env.
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local dev: log driver writes emails to storage/logs/laravel.log (no SMTP).
#
# Gmail SMTP (student invites, etc.):
# - Enable 2-Step Verification, then Google Account → Security → App passwords → create one for "Mail".
# - Copy the 16-character password into MAIL_PASSWORD (spaces optional; Laravel strips them). Never use your normal Gmail password.
# - MAIL_USERNAME and MAIL_FROM_ADDRESS must be that same @gmail.com address.
# - Error "535" / "BadCredentials" always means Google rejected the password — revoke old app passwords and create a new one.
# - After changing mail env vars: php artisan config:clear
# - Optional: php backend/scripts/mail-smoke-test.php to verify SMTP.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_TIMEOUT=30
MAIL_SSL_VERIFY_PEER=true
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SPA origin (browser URL). Production: https://your-frontend-domain.com — used for CORS + links.
FRONTEND_URL=http://localhost:5173
# Optional comma-separated extra origins for CORS. FRONTEND_URL is always included. Add http://127.0.0.1:5173 if Vite opens on 127.0.0.1.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
PAYMONGO_SECRET_KEY=
# Optional, comma-separated (e.g. "card,gcash"). Leave empty to send all allowed methods.
PAYMONGO_PAYMENT_METHODS=
# Optional: path to a CA bundle (cacert.pem) to fix "cURL error 60" on some Windows/PHP setups.
# You can use an absolute path (e.g. C:\path\to\cacert.pem) or a backend-relative path (e.g. storage/certs/cacert.pem).
PAYMONGO_CA_BUNDLE=
# Local-only escape hatch. Prefer setting PAYMONGO_CA_BUNDLE instead of disabling verification.
PAYMONGO_VERIFY_SSL=true

VITE_APP_NAME="${APP_NAME}"

# Demo accounts (DemoAccountsSeeder). Override in production; defaults match local demo users.
DEMO_ADMIN_EMAIL=admin@ojtpath.com
DEMO_ADMIN_PASSWORD=Admin@2026!
DEMO_ADMIN_NAME="System Administrator"
DEMO_COMPANY_EMAIL=company@techcorp.com
DEMO_COMPANY_PASSWORD=Company@2026!
DEMO_SCHOOL_EMAIL=school@cvsu.edu.ph
DEMO_SCHOOL_PASSWORD=School@2026!
DEMO_STUDENT_EMAIL=student@cvsu.edu.ph
DEMO_STUDENT_PASSWORD=Student@2026!
